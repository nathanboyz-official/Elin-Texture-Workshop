<Application x:Class="ElinTextureManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ElinTextureManager.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <conv:NotNullToVisibilityConverter x:Key="NotNullToVis" />
            <conv:CountToVisibilityConverter x:Key="CountToVis" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:EnumMatchConverter x:Key="EnumMatch" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
