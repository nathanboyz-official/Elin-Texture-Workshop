<Window x:Class="ElinTextureManager.App.Views.SheetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ElinTextureManager.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SheetEditorViewModel}"
        Title="Source sheet" Width="1180" Height="760"
        WindowStartupLocation="CenterOwner"
        Closing="OnClosing"
        Background="{StaticResource BackgroundBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ WHAT IS OPEN ============ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding FileName}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding ModName}" Style="{StaticResource SubtleText}"
                       Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>

        <!-- ============ TABS ============ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="SHEET" Style="{StaticResource SectionHeader}"
                       VerticalAlignment="Center" Margin="0,0,10,0" />

            <ComboBox MinWidth="170" ItemsSource="{Binding Tabs}"
                      SelectedItem="{Binding Tab, Mode=TwoWay}"
                      DisplayMemberPath="Name" />

            <TextBlock Text="{Binding TabSummary}" Style="{StaticResource SubtleText}"
                       VerticalAlignment="Center" Margin="14,0,0,0"
                       Foreground="{StaticResource TextMutedBrush}" />

            <Button Content="Add entry" Style="{StaticResource SubtleButton}"
                    Margin="18,0,0,0" Command="{Binding AddRowCommand}" />

            <Button Content="Delete selected" Style="{StaticResource SubtleButton}"
                    Margin="8,0,0,0"
                    Command="{Binding DeleteRowCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=Sheet}" />
        </StackPanel>

        <!-- ============ THE ONE THAT COSTS PEOPLE AN EVENING ============ -->
        <Border Grid.Row="2" Margin="0,0,0,10" Padding="12,8"
                Background="{StaticResource SurfaceSunkenBrush}"
                BorderBrush="{StaticResource DangerBrush}" BorderThickness="2,0,0,0"
                CornerRadius="3"
                Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap"
                       Style="{StaticResource BodyText}" />
        </Border>

        <DataGrid x:Name="Sheet" Grid.Row="3"
                  ItemsSource="{Binding Grid}"
                  AutoGenerateColumns="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  HeadersVisibility="All"
                  GridLinesVisibility="All"
                  FontFamily="Consolas" FontSize="12"
                  Background="{StaticResource SurfaceSunkenBrush}"
                  Foreground="{StaticResource TextPrimaryBrush}"
                  RowBackground="{StaticResource SurfaceSunkenBrush}"
                  AlternatingRowBackground="{StaticResource SurfaceBrush}"
                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                  VerticalGridLinesBrush="{StaticResource BorderBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  ColumnWidth="SizeToHeader"
                  LoadingRow="OnLoadingRow">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="Padding" Value="7,5" />
                    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                    <Setter Property="FontSize" Value="11" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowHeaderStyle>
                <Style TargetType="DataGridRowHeader">
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                    <Setter Property="FontFamily" Value="Consolas" />
                    <Setter Property="FontSize" Value="10.5" />
                    <Setter Property="Padding" Value="6,0" />
                </Style>
            </DataGrid.RowHeaderStyle>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource SubtleText}"
                       MaxWidth="620" HorizontalAlignment="Left" TextWrapping="Wrap"
                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                       Text="Column headers show what an empty cell falls back to. The header, type and default rows are kept exactly as they are - the game reads its columns out of them. A copy of the file is kept before every save." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Style="{StaticResource PrimaryButton}"
                        MinWidth="120" Padding="18,9" Click="OnSave"
                        IsEnabled="{Binding Dirty}" />

                <Button Content="Close" Style="{StaticResource SubtleButton}"
                        Margin="10,0,0,0" Padding="18,9" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
