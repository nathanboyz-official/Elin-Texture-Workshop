<UserControl x:Class="ElinTextureManager.App.Views.LoadOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ElinTextureManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LoadOrderViewModel}">

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Load Order" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource SubtleText}" Margin="0,4,0,0"
                           Text="Global mod order decides which whole mod wins a file conflict. For individual textures, use the per-texture override system instead - it is the recommended workflow." />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Restore Backup" Style="{StaticResource SubtleButton}"
                        Command="{Binding RestoreCommand}" />
                <Button Content="Save Load Order" Margin="6,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>

        <!-- Explanation of the two systems -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="GLOBAL LOAD ORDER" Style="{StaticResource SectionHeader}"
                                   Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource SubtleText}"
                                   Text="Changes which entire mod wins when files conflict." />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="TEXTURE OVERRIDE (RECOMMENDED)"
                                   Style="{StaticResource SectionHeader}" Margin="0,0,0,4"
                                   Foreground="{StaticResource SelectedBrush}" />
                        <TextBlock Style="{StaticResource SubtleText}"
                                   Text="Picks one individual texture regardless of global mod order." />
                    </StackPanel>
                </Grid>

                <Separator Margin="0,10" Background="{StaticResource BorderBrush}" />

                <TextBlock Style="{StaticResource MonoText}" Text="{Binding LoadOrderPath}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource MonoText}" Text="{Binding ConventionNote}" />
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="&#x25B2; Move Up" Command="{Binding MoveUpCommand}"
                            Style="{StaticResource SubtleButton}" />
                    <Button Content="&#x25BC; Move Down" Margin="6,0,0,0"
                            Command="{Binding MoveDownCommand}" Style="{StaticResource SubtleButton}" />
                    <Button Content="Top" Margin="6,0,0,0" Command="{Binding MoveToTopCommand}"
                            Style="{StaticResource SubtleButton}" />
                    <Button Content="Bottom" Margin="6,0,0,0" Command="{Binding MoveToBottomCommand}"
                            Style="{StaticResource SubtleButton}" />
                    <Separator Margin="12,0" />
                    <Button Content="Enable All" Command="{Binding EnableAllCommand}"
                            Style="{StaticResource SubtleButton}" />
                    <Button Content="Disable All" Margin="6,0,0,0"
                            Command="{Binding DisableAllCommand}" Style="{StaticResource SubtleButton}" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Style="{StaticResource SubtleText}">
                    <Run Text="{Binding EnabledCount, Mode=OneWay}" />
                    <Run Text="enabled" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- List -->
        <Grid Grid.Row="3">
            <ListBox x:Name="OrderList" ItemsSource="{Binding Items}"
                     SelectedItem="{Binding Selected}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="OrderList_PreviewMouseLeftButtonDown"
                     MouseMove="OrderList_MouseMove"
                     Drop="OrderList_Drop"
                     DragOver="OrderList_DragOver"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,5" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="10,8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background"
                                                    Value="{StaticResource SurfaceRaisedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="BorderBrush"
                                                    Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="Row" Property="Background"
                                                    Value="{StaticResource SurfaceRaisedBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding PositionText}"
                                       Style="{StaticResource MonoText}" VerticalAlignment="Center" />

                            <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}"
                                      VerticalAlignment="Center" Margin="0,0,10,0"
                                      Checked="Enabled_Changed" Unchecked="Enabled_Changed"
                                      ToolTip="Enable or disable this mod" />

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <Border Style="{StaticResource Pill}" Margin="10,0,0,0"
                                            Background="{StaticResource DangerToneBrush}"
                                            Visibility="{Binding IsMissing,
                                                        Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="NOT INSTALLED" FontSize="9.5"
                                                   Foreground="{StaticResource DangerBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource MonoText}" Text="{Binding Path}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Style="{StaticResource Pill}" Margin="0,0,6,0"
                                        Background="{StaticResource SurfaceHoverBrush}"
                                        Visibility="{Binding HasTextures,
                                                    Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontSize="10.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="{Binding TextureCount, StringFormat={}{0} tex}" />
                                </Border>
                                <Border Style="{StaticResource Pill}" Background="{StaticResource RustToneBrush}"
                                        Visibility="{Binding ConflictCount,
                                                    Converter={StaticResource CountToVis}}">
                                    <TextBlock FontSize="10.5"
                                               Foreground="{StaticResource ConflictBrush}"
                                               Text="{Binding ConflictCount, StringFormat={}{0} conflicts}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- No load order file -->
            <Border Visibility="{Binding HasLoadOrderFile, Converter={StaticResource InverseBoolToVis}}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                <StackPanel>
                    <TextBlock Text="No loadorder.txt found" Style="{StaticResource PageTitle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource SubtleText}" TextAlignment="Center"
                               Margin="0,8,0,0"
                               Text="Elin writes this file once you have opened its in-game mod manager. Your texture overrides work regardless of it." />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="3" VerticalAlignment="Bottom" Margin="0,0,0,10" Padding="12,8"
                CornerRadius="{StaticResource RadiusControl}" Background="{StaticResource SurfaceRaisedBrush}"
                Visibility="{Binding StatusMessage, Converter={StaticResource NotNullToVis}}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" />
        </Border>
    </Grid>
</UserControl>
