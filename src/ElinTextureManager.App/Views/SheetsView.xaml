<UserControl x:Class="ElinTextureManager.App.Views.SheetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ElinTextureManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SheetsViewModel}">

    <Grid Margin="26,22,26,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Source Sheets" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubtleText}"
                           Margin="0,3,0,0" MaxWidth="780" HorizontalAlignment="Left"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>

            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top"
                       Style="{StaticResource MonoText}" Margin="0,7,0,0"
                       Text="{Binding Count, StringFormat={}{0:N0} shown}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Toolbar}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Search" Style="{StaticResource SubtleText}"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{StaticResource TextMutedBrush}" />

                <TextBox MinWidth="280" Padding="7,5"
                         Background="{StaticResource SurfaceSunkenBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         ToolTip="By mod, file name or sheet"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Reading the library..." Style="{StaticResource SubtleText}"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{StaticResource TextMutedBrush}"
                           Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Files}" Margin="0,0,14,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,12">
                            <Grid>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FileName}" FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Border Background="{StaticResource SurfaceSunkenBrush}"
                                                CornerRadius="3" Padding="6,1" Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Where}" FontFamily="Consolas"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding ModName}" Style="{StaticResource SubtleText}"
                                               Margin="0,4,0,0"
                                               Foreground="{StaticResource TextMutedBrush}" />

                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource MonoText}"
                                               Margin="0,3,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Button Content="Edit" Style="{StaticResource PrimaryButton}"
                                            Padding="16,7"
                                            Command="{Binding DataContext.OpenCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />

                                    <Button Content="Folder" Style="{StaticResource SubtleButton}"
                                            Margin="8,0,0,0" Padding="14,7"
                                            Command="{Binding DataContext.OpenFolderCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
