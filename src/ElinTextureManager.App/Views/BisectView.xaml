<UserControl x:Class="ElinTextureManager.App.Views.BisectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ElinTextureManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BisectViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24" MaxWidth="880" HorizontalAlignment="Left">

            <!-- === HEADER === -->
            <TextBlock Text="Find the Culprit" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource SubtleText}" Margin="0,4,0,14" TextWrapping="Wrap"
                       Text="Elin's release notes say the same thing after every update: if something is behaving strangely, turn mods off and test again. Done one at a time that is hundreds of launches. This halves the list each round instead, so it takes about nine." />

            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>

            <!-- === SETUP === -->
            <Border Style="{StaticResource Card}" Padding="16"
                    Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="WHAT IS WRONG" Style="{StaticResource SectionHeader}" />
                    <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,6,0,8"
                               Text="Write it down for yourself - it is only ever shown back to you, and after nine launches it is easy to lose track of exactly what you were testing." />

                    <TextBox Padding="9,7" MinHeight="34" TextWrapping="Wrap" AcceptsReturn="True"
                             Text="{Binding Problem, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource SurfaceSunkenBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}" />

                    <TextBlock Text="{Binding ScopeText}" Style="{StaticResource MonoText}" Margin="0,12,0,0" />

                    <Expander Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                        <Expander.Header>
                            <TextBlock FontSize="12">
                                <Run Text="{Binding PinnedCount, Mode=OneWay}" />
                                <Run Text="mods stay on the whole time" />
                            </TextBlock>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Other mods are built against these. Turning one off would not test it - it would break everything that needs it and produce a different failure than the one you are chasing." />
                            <ItemsControl ItemsSource="{Binding Pinned}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Pill}" Margin="0,0,6,6"
                                                Background="{StaticResource SurfaceSunkenBrush}">
                                            <TextBlock Text="{Binding Name}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <Button Content="Start the search" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Margin="0,14,0,0"
                            Command="{Binding StartCommand}" />
                </StackPanel>
            </Border>

            <!-- === A ROUND IN PROGRESS === -->
            <Border Style="{StaticResource Card}" Padding="18"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding RoundTitle}" FontSize="15.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource MonoText}">
                            <Run Text="about" />
                            <Run Text="{Binding RoundsLeft, Mode=OneWay}" />
                            <Run Text="launches left" />
                        </TextBlock>
                    </Grid>

                    <TextBlock Text="{Binding TrialSummary}" Style="{StaticResource MonoText}" Margin="0,6,0,0" />

                    <TextBlock Text="{Binding RoundInstruction}" TextWrapping="Wrap" Margin="0,12,0,0"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />

                    <Border Background="{StaticResource DangerToneBrush}"
                            BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}" Padding="11,8" Margin="0,12,0,0"
                            Visibility="{Binding GameIsRunning, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                                   Text="Elin is running right now. It reads the load order when it starts, so close it and start it again or this round tests the mods you had before." />
                    </Border>

                    <Button Content="Start Elin" Style="{StaticResource SubtleButton}"
                            HorizontalAlignment="Left" Margin="0,14,0,0"
                            Command="{Binding LaunchGameCommand}" />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14" />

                    <TextBlock Text="WHAT HAPPENED?" Style="{StaticResource SectionHeader}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Still broken" Style="{StaticResource DangerButton}"
                                Margin="0,0,8,0" Command="{Binding StillBrokenCommand}" />
                        <Button Content="Problem is gone" Style="{StaticResource SuccessButton}"
                                Margin="0,0,8,0" Command="{Binding FixedCommand}" />
                        <Button Content="Stop and put everything back" Style="{StaticResource SubtleButton}"
                                Command="{Binding CancelCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- === THE ANSWER === -->
            <Border Padding="18" CornerRadius="{StaticResource RadiusPanel}" BorderThickness="1"
                    Background="{StaticResource SurfaceBrush}"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCulprit}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <TextBlock Text="{Binding ResultTitle}" FontSize="17"
                               FontFamily="{StaticResource DisplayFont}"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding ResultDetail}" TextWrapping="Wrap" Margin="0,8,0,0"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />

                    <Button Content="Search again" Style="{StaticResource SubtleButton}"
                            HorizontalAlignment="Left" Margin="0,14,0,0"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
