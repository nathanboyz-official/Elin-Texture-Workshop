<UserControl x:Class="ElinTextureManager.App.Views.NewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ElinTextureManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:NewsViewModel}">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Game News" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource SubtleText}" Margin="0,4,0,0"
                           Text="Elin's own Steam announcements. A stable update is the usual reason a texture mod stops working." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <TextBlock Text="{Binding FetchedText}" Style="{StaticResource SubtleText}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Content="Check now" Style="{StaticResource SubtleButton}"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsIdle}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}"
                Padding="12,10" Margin="0,0,0,12"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </Border>

        <!-- ============ ANNOUNCEMENTS ============ -->
        <ScrollViewer Grid.Row="2" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                      Padding="0,0,8,0">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusPanel}" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource Pill}"
                                            Background="{StaticResource AccentDarkBrush}"
                                            Margin="0,0,8,0"
                                            Visibility="{Binding IsPatchNote,
                                                        Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="PATCH" FontSize="9.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding DateText}" Style="{StaticResource MonoText}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="·" Margin="7,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding Author}" Style="{StaticResource MonoText}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,7,0,0"
                                           Foreground="{StaticResource TextPrimaryBrush}" />

                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,7,0,0"
                                           FontSize="12.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Visibility="{Binding Expanded,
                                                       Converter={StaticResource InverseBoolToVis}}" />

                                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Margin="0,7,0,0"
                                           FontSize="12.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Visibility="{Binding Expanded,
                                                       Converter={StaticResource BoolToVis}}" />

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Read more" Style="{StaticResource SubtleButton}"
                                            Margin="0,0,6,0"
                                            Visibility="{Binding CanExpand,
                                                        Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.ToggleExpandCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Open on Steam" Style="{StaticResource SubtleButton}"
                                            Command="{Binding DataContext.OpenPostCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ============ RECENTLY UPDATED MODS ============ -->
        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}"
                VerticalAlignment="Top" Padding="14">
            <StackPanel>
                <TextBlock Text="RECENTLY UPDATED MODS" Style="{StaticResource SectionHeader}" />
                <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,4,0,10"
                           Text="From the folder timestamps on this machine, so this works with or without Steam news." />

                <ItemsControl ItemsSource="{Binding RecentMods}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis" MaxWidth="200"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <Border Style="{StaticResource Pill}" Margin="7,0,0,0"
                                            Background="{StaticResource DangerToneBrush}"
                                            Visibility="{Binding Enabled,
                                                        Converter={StaticResource InverseBoolToVis}}">
                                        <TextBlock Text="OFF" FontSize="9"
                                                   Foreground="{StaticResource DangerBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource MonoText}">
                                    <Run Text="{Binding UpdatedText, Mode=OneWay}" />
                                    <Run Text="  ·  " Foreground="{StaticResource TextMutedBrush}" />
                                    <Run Text="{Binding DetailText, Mode=OneWay}"
                                         Foreground="{StaticResource TextMutedBrush}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
