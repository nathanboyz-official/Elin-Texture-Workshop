<UserControl x:Class="ElinTextureManager.App.Views.DressUpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ElinTextureManager.App.ViewModels"
             xmlns:controls="clr-namespace:ElinTextureManager.App.Controls"
             xmlns:ctrl="clr-namespace:ElinTextureManager.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DressUpViewModel}">

    <UserControl.Resources>
        <!-- A row in the slot rail or a tile in the parts grid: flat until it is the
             chosen one, then outlined in gold like every other choice in the app. -->
        <ControlTemplate x:Key="PickTemplate" TargetType="Button">
            <Border x:Name="Shell" Padding="{TemplateBinding Padding}"
                    Background="{StaticResource SurfaceSunkenBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}">
                <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Shell" Property="BorderBrush"
                            Value="{StaticResource BorderStrongBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsChosen}" Value="True">
                    <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                    <Setter TargetName="Shell" Property="Background" Value="{StaticResource GoldToneBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasChoice}" Value="True">
                    <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource GoldDimBrush}" />
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- One tile, used by both the Creations section and the main grid. -->
        <DataTemplate x:Key="PartTile">
                                <Button Width="100" Margin="0,0,8,8" Padding="0"
                                        HorizontalContentAlignment="Stretch"
                                        Template="{StaticResource PickTemplate}"
                                        Command="{Binding DataContext.ChoosePartCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <!-- The menu's own DataContext is the part, so the
                                         page's commands are reached through Tag. -->
                                    <Button.Tag>
                                        <Binding Path="DataContext"
                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </Button.Tag>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Edit a copy of this sprite..."
                                                      Command="{Binding PlacementTarget.Tag.EditPartCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Delete this sprite"
                                                      Command="{Binding PlacementTarget.Tag.DeletePartCommand,
                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel>
                                        <Grid Height="144">
                                            <Border Background="{StaticResource CheckerboardBrush}"
                                                    CornerRadius="2,2,0,0" />
                                            <Image Source="{Binding Thumbnail}" Stretch="None"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />

                                            <!-- No entry: the empty choice, drawn rather
                                                 than rendered from a part. The bar runs
                                                 top-left to bottom-right, as the sign
                                                 everyone already knows does. -->
                                            <Grid Width="52" Height="52"
                                                  Visibility="{Binding IsNone,
                                                              Converter={StaticResource BoolToVis}}">
                                                <Ellipse Stroke="#E01B1B" StrokeThickness="7" />
                                                <Rectangle Height="7" Width="38" Fill="#E01B1B"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           RenderTransformOrigin="0.5,0.5">
                                                    <Rectangle.RenderTransform>
                                                        <RotateTransform Angle="45" />
                                                    </Rectangle.RenderTransform>
                                                </Rectangle>
                                            </Grid>
                                            <Border Style="{StaticResource Pill}" Margin="4"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Background="{StaticResource BlueToneBrush}"
                                                    Visibility="{Binding HasBack,
                                                                Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="+BACK" FontSize="8"
                                                           Foreground="{StaticResource BlueBrush}" />
                                            </Border>

                                            <!-- The star sits over the tile, so it must
                                                 not pass its click through to the tile
                                                 underneath and change the part as well. -->
                                            <Button Style="{StaticResource StarButton}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    ToolTip="Keep this one near the top"
                                                    Visibility="{Binding CanFavourite,
                                                                Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.ToggleFavouriteCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                        <StackPanel Margin="7,5,7,7">
                                            <TextBlock Text="{Binding Id}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding ModName}" FontSize="10" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="286" />
        </Grid.ColumnDefinitions>

        <!-- === HEADER === -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Character Creator" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource SubtleText}" Margin="0,4,0,0" TextWrapping="Wrap"
                           MaxWidth="820" HorizontalAlignment="Left"
                           Text="The same slots, in the same order, with the same names Elin uses. Build a character here and save it where the game's own Edit Appearance screen will find it." />
            </StackPanel>
            <TextBlock Text="{Binding ScopeText}" Style="{StaticResource MonoText}"
                       HorizontalAlignment="Right" VerticalAlignment="Top" />
        </Grid>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="12,9"
                Margin="0,0,0,12"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </Border>

        <!-- === SLOTS, IN THE GAME'S ORDER === -->
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Padding="9" Margin="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,0,3" Padding="9,6" HorizontalContentAlignment="Stretch"
                                    Template="{StaticResource PickTemplate}"
                                    Command="{Binding DataContext.SelectSlotCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="12.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Detail}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource MonoText}" />
                                    </StackPanel>
                                    <Border Width="12" Height="12" CornerRadius="2"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="{Binding Swatch}"
                                            BorderBrush="{StaticResource BorderStrongBrush}"
                                            BorderThickness="1"
                                            Visibility="{Binding HasColour,
                                                        Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- === PARTS FOR THE CHOSEN SLOT === -->
        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,9">
                    <TextBlock Text="{Binding PartsTitle}" Style="{StaticResource SectionHeader}"
                               VerticalAlignment="Center" />

                    <!-- The slot rail is already the answer to "what kind", so the button
                         says which kind it is about to make. -->
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                            Padding="10,3" FontSize="11"
                            Content="{Binding NewSpriteLabel}"
                            ToolTip="Draw one from nothing, for this slot"
                            Command="{Binding NewSpriteCommand}" />
                </Grid>

                <!-- Dye for the chosen slot. A WrapPanel because the swatches plus the
                     user's saved colours outgrow one line, and the saved ones were being
                     pushed off the right edge where nobody would ever see them. -->
                <WrapPanel Grid.Row="1" Margin="0,0,0,10" Orientation="Horizontal">
                    <ToggleButton x:Name="WheelToggle" Width="22" Height="22" Margin="0,0,8,0"
                                  Padding="0" ToolTip="Colour wheel">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Chip" CornerRadius="11"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1">
                                    <Border.Background>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#FFFFFF" Offset="0" />
                                            <GradientStop Color="#C86464" Offset="1" />
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Chip" Property="BorderBrush"
                                                Value="{StaticResource GoldBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Button Content="Random" Style="{StaticResource SubtleButton}"
                            Padding="7,2" FontSize="10.5" Margin="0,0,8,0"
                            ToolTip="A random colour for this slot"
                            Command="{Binding RandomSlotColourCommand}" />
                    <Button Content="Roll part" Style="{StaticResource SubtleButton}"
                            Padding="7,2" FontSize="10.5" Margin="0,0,6,0"
                            ToolTip="A random part for this slot"
                            Command="{Binding RandomSlotPartCommand}" />
                    <Button Content="Pick" Style="{StaticResource SubtleButton}"
                            Padding="7,2" FontSize="10.5" Margin="0,0,6,0"
                            ToolTip="Take a colour from anywhere on screen"
                            Command="{Binding PickFromScreenCommand}" />
                    <Button Content="Save" Style="{StaticResource SubtleButton}"
                            Padding="7,2" FontSize="10.5" Margin="0,0,10,0"
                            ToolTip="Keep this colour for later"
                            Command="{Binding SaveColourCommand}" />
                    <ItemsControl ItemsSource="{Binding Dyes}" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="20" Height="20" Margin="0,0,4,0" Padding="0"
                                        Command="{Binding DataContext.ChooseDyeCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Chip" CornerRadius="3"
                                                    Background="{Binding Swatch}"
                                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="/" FontSize="12" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Visibility="{Binding IsNone,
                                                                       Converter={StaticResource BoolToVis}}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chip" Property="BorderBrush"
                                                            Value="{StaticResource GoldBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Kept colours, behind their own divider so it is clear which ones
                         are the user's and which came with the application. -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding HasSavedDyes, Converter={StaticResource BoolToVis}}">
                        <Border Width="1" Margin="8,2,8,2"
                                Background="{StaticResource BorderStrongBrush}" />
                        <TextBlock Text="SAVED" FontSize="9" VerticalAlignment="Center"
                                   Margin="0,0,7,0"
                                   Foreground="{StaticResource TextMutedBrush}" />

                        <ItemsControl ItemsSource="{Binding SavedDyes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="20" Height="20" Margin="0,0,4,0" Padding="0"
                                            ToolTip="{Binding Label}"
                                            Command="{Binding DataContext.ChooseDyeCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Tag>
                                            <Binding Path="DataContext"
                                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </Button.Tag>
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Remove this saved colour"
                                                          Command="{Binding PlacementTarget.Tag.ForgetColourCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Chip" CornerRadius="3"
                                                        Background="{Binding Swatch}"
                                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                                        BorderThickness="1" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chip" Property="BorderBrush"
                                                                Value="{StaticResource GoldBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </WrapPanel>

                <!-- The wheel, folded away until asked for: the swatches cover most
                     choices and a picker sitting open costs the parts grid its room. -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12"
                        Margin="0,0,0,10" HorizontalAlignment="Left"
                        Visibility="{Binding IsChecked, ElementName=WheelToggle,
                                    Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <controls:ColourWheel Hex="{Binding SlotColour, Mode=TwoWay}" />
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Bottom">
                            <Border Width="60" Height="60" CornerRadius="{StaticResource RadiusControl}"
                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                    Background="{Binding SelectedSlot.Swatch}" />
                            <TextBox Width="80" Margin="0,8,0,0" Padding="6,4" FontFamily="Consolas"
                                     Text="{Binding SlotColour, UpdateSourceTrigger=LostFocus}"
                                     Background="{StaticResource SurfaceSunkenBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="{StaticResource BorderBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>


                <!-- === CREATIONS === -->
                <!-- Parts made here, above the rest and in their own section: they are
                     the ones being worked on, and hunting for them among a thousand
                     installed parts is not a search anyone should have to do. -->
                <StackPanel Grid.Row="3" Margin="0,0,0,10"
                            Visibility="{Binding HasCreations, Converter={StaticResource BoolToVis}}">
                    <!-- The heading folds the section away. Once a few parts have been
                         made here they push the installed ones off the screen, and they
                         are not always what is being looked for. The count stays on show
                         while folded, so nothing goes quietly missing. -->
                    <Button Command="{Binding ToggleCreationsCommand}"
                            HorizontalAlignment="Left" Cursor="Hand"
                            Margin="-4,0,0,4"
                            ToolTip="Show or hide the parts you have made"
                            AutomationProperties.Name="CREATIONS"
                            AutomationProperties.HelpText="Show or hide the parts you have made">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Hit" Background="Transparent"
                                        CornerRadius="3" Padding="4,2">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Hit" Property="Background"
                                                Value="{StaticResource SurfaceSunkenBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CreationsChevron}"
                                       Style="{StaticResource SectionHeader}"
                                       Width="10" Margin="0" />
                            <TextBlock Text="CREATIONS"
                                       Style="{StaticResource SectionHeader}" Margin="0" />
                            <TextBlock Text="{Binding Creations.Count, StringFormat=({0})}"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="5,0,0,0" />
                        </StackPanel>
                    </Button>

                    <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding CreationsShown,
                                               Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Creations}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <StaticResource ResourceKey="PartTile" />
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Height="1" Margin="0,10,0,0"
                            Background="{StaticResource BorderBrush}" />
                </StackPanel>

                <!-- Virtualised: Tops alone holds over a thousand parts, and turning the
                     character redraws every tile that is realised. Only the ones on
                     screen should pay for that. -->
                <ItemsControl Grid.Row="4" ItemsSource="{Binding Parts}"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer Focusable="False" Padding="0,0,4,0">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctrl:VirtualizingWrapPanel ItemWidth="108" ItemHeight="196" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="PartTile" />
                        </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- === THE CHARACTER === -->
        <ScrollViewer Grid.Row="2" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="THE CHARACTER" Style="{StaticResource SectionHeader}" />

                        <Grid Margin="0,10,0,0" Height="290">
                            <Border CornerRadius="{StaticResource RadiusControl}"
                                    Background="{StaticResource CheckerboardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Image Source="{Binding Preview}" Stretch="None"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>

                            <!-- Small buttons sitting over the picture, as the game has
                                 them, rather than columns that squeeze the character. -->
                            <Button Style="{StaticResource TurnButton}" Content="&#x25C0;"
                                    HorizontalAlignment="Left" Margin="6,0,0,0"
                                    ToolTip="Turn one quarter, this way"
                                    Command="{Binding TurnCommand}" CommandParameter="1" />

                            <Button Style="{StaticResource TurnButton}" Content="&#x25B6;"
                                    HorizontalAlignment="Right" Margin="0,0,6,0"
                                    ToolTip="Turn one quarter, the other way"
                                    Command="{Binding TurnCommand}" CommandParameter="-1" />
                        </Grid>

                        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,12,0,6">
                            <Run Text="FACING" />
                            <Run Text="{Binding FacingName, Mode=OneWay}"
                                 Foreground="{StaticResource GoldBrush}" />
                        </TextBlock>

                        <UniformGrid Columns="4">
                            <RadioButton Content="Front" GroupName="Face" Margin="0,0,4,0" FontSize="11"
                                         IsChecked="{Binding IsFacingFront, Mode=TwoWay}" />
                            <RadioButton Content="Left" GroupName="Face" Margin="0,0,4,0" FontSize="11"
                                         IsChecked="{Binding IsFacingLeft, Mode=TwoWay}" />
                            <RadioButton Content="Right" GroupName="Face" Margin="0,0,4,0" FontSize="11"
                                         IsChecked="{Binding IsFacingRight, Mode=TwoWay}" />
                            <RadioButton Content="Back" GroupName="Face" FontSize="11"
                                         IsChecked="{Binding IsFacingBack, Mode=TwoWay}" />
                        </UniformGrid>
                        <Grid Margin="0,12,0,0">
                            <CheckBox Content="Walk" IsChecked="{Binding Animate}" VerticalAlignment="Center" />
                            <Slider Width="130" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding WalkSpeed}"
                                    ToolTip="Walking speed" />
                        </Grid>

                        <UniformGrid Columns="2" Margin="0,12,0,0">
                            <Button Content="Regenerate" Style="{StaticResource SubtleButton}"
                                    Margin="0,0,3,0"
                                    ToolTip="A whole new character: new parts and new colours"
                                    Command="{Binding RandomiseCommand}" />
                            <Button Content="Random Colour" Style="{StaticResource SubtleButton}"
                                    Margin="3,0,0,0"
                                    ToolTip="Re-dye what this character is already wearing"
                                    Command="{Binding RandomColoursCommand}" />
                        </UniformGrid>
                        <Button Content="Start over" Style="{StaticResource SubtleButton}"
                                HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                Command="{Binding NewCharacterCommand}" />
                    </StackPanel>
                </Border>

                <!-- === SAVING INTO THE GAME === -->
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="SAVE INTO ELIN" Style="{StaticResource SectionHeader}" />

                        <TextBox Margin="0,10,0,0" Padding="8,5"
                                 Text="{Binding CharacterName, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource SurfaceSunkenBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" />

                        <Button Content="Save as a named character" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                Command="{Binding SaveCommand}" />

                        <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Goes to Elin\User\PCC. Open Edit Appearance in game and press Import to load it." />

                        <TextBlock Text="OR STRAIGHT INTO A FAV SLOT" Style="{StaticResource SectionHeader}"
                                   Margin="0,14,0,6" />
                        <UniformGrid Columns="5">
                            <Button Content="1" Style="{StaticResource SubtleButton}" Margin="0,0,4,0"
                                    Command="{Binding SaveToSlotCommand}" CommandParameter="1" />
                            <Button Content="2" Style="{StaticResource SubtleButton}" Margin="0,0,4,0"
                                    Command="{Binding SaveToSlotCommand}" CommandParameter="2" />
                            <Button Content="3" Style="{StaticResource SubtleButton}" Margin="0,0,4,0"
                                    Command="{Binding SaveToSlotCommand}" CommandParameter="3" />
                            <Button Content="4" Style="{StaticResource SubtleButton}" Margin="0,0,4,0"
                                    Command="{Binding SaveToSlotCommand}" CommandParameter="4" />
                            <Button Content="5" Style="{StaticResource SubtleButton}"
                                    Command="{Binding SaveToSlotCommand}" CommandParameter="5" />
                        </UniformGrid>
                        <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Overwrites that Load Fav button in game. Quicker, but it replaces whatever was there." />
                    </StackPanel>
                </Border>

                <!-- === CHARACTERS ALREADY SAVED IN THE GAME === -->
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="SAVED IN ELIN" Style="{StaticResource SectionHeader}"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Folder" Style="{StaticResource SubtleButton}"
                                        Padding="7,2" FontSize="10.5" Margin="0,0,4,0"
                                        Command="{Binding OpenFolderCommand}" />
                                <Button Content="Reload" Style="{StaticResource SubtleButton}"
                                        Padding="7,2" FontSize="10.5"
                                        Command="{Binding RefreshStylesCommand}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,7,0,8"
                                   Text="Everything the game's own editor has saved, read straight from its folder - the five Fav slots and every export." />

                        <ItemsControl ItemsSource="{Binding SavedStyles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,4" Padding="10,7"
                                            HorizontalContentAlignment="Stretch"
                                            Template="{StaticResource PickTemplate}"
                                            Command="{Binding DataContext.LoadStyleCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Detail}" Margin="0,2,0,0"
                                                       Style="{StaticResource MonoText}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
