<UserControl x:Class="ElinTextureManager.App.Views.DressUpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ElinTextureManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DressUpViewModel}">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="264" />
        </Grid.ColumnDefinitions>

        <!-- === HEADER === -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Dress Up" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource SubtleText}" Margin="0,4,0,0" TextWrapping="Wrap"
                           MaxWidth="820" HorizontalAlignment="Left"
                           Text="PCC parts are greyscale sheets of sixteen tiny poses that Elin tints while it draws, so one on its own tells you nothing. Stack them the way the game does and you can see what a hairstyle or a coat actually looks like - and which mod it came from." />
            </StackPanel>
            <TextBlock Text="{Binding ScopeText}" Style="{StaticResource MonoText}"
                       HorizontalAlignment="Right" VerticalAlignment="Top" />
        </Grid>

        <!-- === LAYERS === -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Layers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button HorizontalContentAlignment="Stretch" Margin="0,0,0,3" Padding="0"
                                    Command="{Binding DataContext.SelectLayerCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Shell" Padding="9,6" CornerRadius="{StaticResource RadiusControl}"
                                                Background="Transparent" BorderThickness="1"
                                                BorderBrush="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Shell" Property="Background"
                                                        Value="{StaticResource SurfaceHoverBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding HasChoice}" Value="True">
                                                <Setter TargetName="Shell" Property="BorderBrush"
                                                        Value="{StaticResource GoldDimBrush}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="12.5"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding ChosenText}" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource MonoText}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- === PARTS FOR THE CHOSEN LAYER === -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{Binding PartsTitle}" Style="{StaticResource SectionHeader}"
                               VerticalAlignment="Center" />
                    <Button Content="Use none" Style="{StaticResource SubtleButton}"
                            HorizontalAlignment="Right" Padding="7,2" FontSize="10.5"
                            Command="{Binding ClearLayerCommand}" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Parts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="104" Margin="0,0,8,8" Padding="0"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.ChoosePartCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Shell"
                                                    Background="{StaticResource SurfaceSunkenBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusControl}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Shell" Property="BorderBrush"
                                                            Value="{StaticResource BorderStrongBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsChosen}" Value="True">
                                                    <Setter TargetName="Shell" Property="BorderBrush"
                                                            Value="{StaticResource GoldBrush}" />
                                                    <Setter TargetName="Shell" Property="Background"
                                                            Value="{StaticResource GoldToneBrush}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>

                                    <StackPanel>
                                        <Border Background="{StaticResource CheckerboardBrush}"
                                                CornerRadius="2,2,0,0" Height="150">
                                            <Image Source="{Binding Thumbnail}" Stretch="None"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        </Border>
                                        <StackPanel Margin="7,5,7,7">
                                            <TextBlock Text="{Binding UniqueId}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding ModName}" FontSize="10" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- === THE CHARACTER === -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="14"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="THE CHARACTER" Style="{StaticResource SectionHeader}" />

                <Border Margin="0,10,0,0" Height="300" CornerRadius="{StaticResource RadiusControl}"
                        Background="{StaticResource CheckerboardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Image Source="{Binding Preview}" Stretch="None"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>

                <TextBlock Text="FACING" Style="{StaticResource SectionHeader}" Margin="0,14,0,6" />
                <UniformGrid Columns="4">
                    <RadioButton Content="Front" GroupName="Face" Margin="0,0,4,0" FontSize="11"
                                 IsChecked="True"
                                 Command="{Binding FaceCommand}" CommandParameter="0" />
                    <RadioButton Content="Left" GroupName="Face" Margin="0,0,4,0" FontSize="11"
                                 Command="{Binding FaceCommand}" CommandParameter="1" />
                    <RadioButton Content="Right" GroupName="Face" Margin="0,0,4,0" FontSize="11"
                                 Command="{Binding FaceCommand}" CommandParameter="2" />
                    <RadioButton Content="Back" GroupName="Face" FontSize="11"
                                 Command="{Binding FaceCommand}" CommandParameter="3" />
                </UniformGrid>

                <CheckBox Content="Walk" Margin="0,12,0,0" IsChecked="{Binding Animate}" />

                <Button Content="Randomise" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch" Margin="0,14,0,0"
                        Command="{Binding RandomiseCommand}" />
                <Button Content="Start over" Style="{StaticResource SubtleButton}"
                        HorizontalAlignment="Stretch" Margin="0,6,0,0"
                        Command="{Binding ClearAllCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
