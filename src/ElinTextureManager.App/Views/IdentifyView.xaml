<UserControl x:Class="ElinTextureManager.App.Views.IdentifyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ElinTextureManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" AllowDrop="True"
             Drop="OnDrop" DragOver="OnDragOver"
             d:DataContext="{d:DesignInstance vm:IdentifyViewModel}">

    <UserControl.InputBindings>
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- === HEADER === -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14">
            <TextBlock Text="Identify" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource SubtleText}" Margin="0,4,0,0" TextWrapping="Wrap"
                       MaxWidth="760" HorizontalAlignment="Left"
                       Text="Saw a character you do not recognise? Screenshot it, crop it to just that character, and paste it here. This ranks every image in your library by how well its colours fit the crop, then checks the closest ones pixel by pixel." />
        </StackPanel>

        <!-- === QUERY === -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource Card}"
                Padding="16" Margin="0,0,16,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="THE CROP" Style="{StaticResource SectionHeader}" />

                <Border Margin="0,10,0,0" MinHeight="160" CornerRadius="{StaticResource RadiusControl}"
                        Background="{StaticResource CheckerboardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="18"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding NoQuery, Converter={StaticResource BoolToVis}}"
                                   Text="Paste with Ctrl+V, or drop an image file anywhere on this page." />
                        <Image Source="{Binding QueryImage}" Margin="8" MaxHeight="260"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasQuery, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>

                <TextBlock Text="{Binding QuerySource}" Style="{StaticResource MonoText}"
                           Margin="0,7,0,0" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasQuerySource, Converter={StaticResource BoolToVis}}" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Paste" Style="{StaticResource SubtleButton}" Margin="0,0,6,0"
                            Command="{Binding PasteCommand}" />
                    <Button Content="Browse" Style="{StaticResource SubtleButton}" Margin="0,0,6,0"
                            Command="{Binding BrowseCommand}" />
                    <Button Content="Clear" Style="{StaticResource SubtleButton}"
                            Command="{Binding ClearCommand}" />
                </StackPanel>

                <Button Content="Find it" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"
                        HorizontalAlignment="Stretch" Command="{Binding SearchCommand}" />

                <ProgressBar Height="3" Margin="0,10,0,0" Maximum="1" BorderThickness="0"
                             Background="{StaticResource SurfaceSunkenBrush}"
                             Foreground="{StaticResource AccentBrush}"
                             Value="{Binding IndexProgress, Mode=OneWay}"
                             Visibility="{Binding ShowIndexProgress, Converter={StaticResource BoolToVis}}" />

                <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding ShowIndexProgress, Converter={StaticResource BoolToVis}}"
                           Text="Reading the library's colours. This happens once - afterwards only new or changed images are read again." />

                <TextBlock Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,14,0,0"
                           Text="Crop tightly. Floor and walls in the crop are tolerated, but the less of them the better." />
            </StackPanel>
        </Border>

        <!-- === STATUS === -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="12,10"
                Margin="0,0,0,12" VerticalAlignment="Top"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </Border>

        <!-- === RESULTS === -->
        <Grid Grid.Row="2" Grid.Column="1">

            <TextBlock VerticalAlignment="Top" Style="{StaticResource SubtleText}"
                       Text="Searching..."
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0"
                          Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="164" Margin="0,0,10,10" Padding="0"
                                    HorizontalContentAlignment="Stretch"
                                    Command="{Binding DataContext.OpenResultCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Shell"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusPanel}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Shell" Property="Background"
                                                        Value="{StaticResource SurfaceHoverBrush}" />
                                                <Setter TargetName="Shell" Property="BorderBrush"
                                                        Value="{StaticResource BorderStrongBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsStrongMatch}" Value="True">
                                                <Setter TargetName="Shell" Property="BorderBrush"
                                                        Value="{StaticResource GoldBrush}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>

                                <StackPanel>
                                    <Border Height="132" CornerRadius="2,2,0,0"
                                            Background="{StaticResource CheckerboardBrush}">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                               Margin="6" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>

                                    <StackPanel Margin="10,8,10,10">
                                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Left"
                                                Background="{StaticResource GoldToneBrush}" Margin="0,0,0,5"
                                                Visibility="{Binding IsStrongMatch,
                                                            Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="SAME IMAGE" FontSize="9"
                                                       Foreground="{StaticResource GoldBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding FileName}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding ModName}" FontSize="11.5" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding ScoreText}" Margin="0,3,0,0"
                                                   Style="{StaticResource MonoText}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
