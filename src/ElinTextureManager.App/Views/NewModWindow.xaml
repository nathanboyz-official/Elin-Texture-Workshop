<Window x:Class="ElinTextureManager.App.Views.NewModWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ElinTextureManager.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:NewModViewModel}"
        Title="Start a mod" Width="700" Height="780"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Background" Value="{StaticResource SurfaceSunkenBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Start a mod" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource SubtleText}" Margin="0,3,0,0"
                       TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="Creates the folder, package.xml with the fields the game reads, and source sheets that already carry the official first three rows." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,14,0">

                <TextBlock Text="TITLE" Style="{StaticResource SectionHeader}" Margin="0,0,0,5" />
                <TextBox Style="{StaticResource Field}"
                         Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="The name shown on the Workshop." Style="{StaticResource SubtleText}"
                           FontSize="11" Margin="0,0,0,14"
                           Foreground="{StaticResource TextMutedBrush}" />

                <TextBlock Text="ID" Style="{StaticResource SectionHeader}" Margin="0,0,0,5" />
                <TextBox x:Name="IdBox" Style="{StaticResource Field}"
                         TextChanged="OnIdTyped"
                         Text="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource SubtleText}" FontSize="11" Margin="0,0,0,4"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="The folder name, and how Steam knows this mod. Never change it after publishing - Steam treats a changed id as a different mod, so the update reaches nobody." />

                <TextBlock Text="{Binding FolderPath}" FontFamily="Consolas" FontSize="11.5"
                           Margin="0,0,0,4" TextWrapping="Wrap"
                           Foreground="{StaticResource AccentBrush}" />

                <TextBlock Text="{Binding Problem}" Style="{StaticResource SubtleText}"
                           FontSize="11" Margin="0,0,0,14" TextWrapping="Wrap"
                           Foreground="{StaticResource DangerBrush}"
                           Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}" />

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="AUTHOR" Style="{StaticResource SectionHeader}" Margin="0,0,0,5" />
                        <TextBox Style="{StaticResource Field}"
                                 Text="{Binding Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="TAGS" Style="{StaticResource SectionHeader}" Margin="0,0,0,5" />
                        <TextBox Style="{StaticResource Field}"
                                 ToolTip="Workshop categories, comma separated"
                                 Text="{Binding Tags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="DESCRIPTION" Style="{StaticResource SectionHeader}" Margin="0,0,0,5" />
                <TextBox Style="{StaticResource Field}" Height="56"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="" Margin="0,0,0,14" />

                <!-- ============ SOURCE SHEETS ============ -->
                <TextBlock Text="START THESE SHEETS" Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,5" />
                <TextBlock Text="{Binding SheetNote}" Style="{StaticResource SubtleText}"
                           FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                           MaxWidth="620" HorizontalAlignment="Left"
                           Foreground="{StaticResource TextMutedBrush}" />

                <ItemsControl ItemsSource="{Binding Sheets}" Margin="0,0,0,14"
                              Visibility="{Binding HasSheets, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Chosen, Mode=TwoWay}" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Tab}" FontFamily="Consolas"
                                               FontSize="12.5" MinWidth="90"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SubtleText}"
                                               FontSize="11" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ============ FOLDERS ============ -->
                <TextBlock Text="CREATE THESE FOLDERS" Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,8" />

                <ItemsControl ItemsSource="{Binding Folders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Chosen, Mode=TwoWay}" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Display}" FontFamily="Consolas"
                                               FontSize="12.5" MinWidth="150"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding What}" Style="{StaticResource SubtleText}"
                                               FontSize="11" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Create mod" Style="{StaticResource PrimaryButton}"
                    MinWidth="150" Padding="18,9" IsDefault="True" Click="OnCreate"
                    IsEnabled="{Binding CanCreate}" />
            <Button Content="Cancel" Style="{StaticResource SubtleButton}"
                    Margin="10,0,0,0" Padding="18,9" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
