<UserControl x:Class="ElinTextureManager.App.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ElinTextureManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ModsViewModel}">

    <UserControl.Resources>
        <!-- A Workshop-style section chip. -->
        <Style x:Key="SectionChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" CornerRadius="{StaticResource RadiusChip}" Padding="12,6"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Label" Text="{Binding Label}"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="Count" Text="{Binding Count}" Margin="7,0,0,0"
                                           FontSize="10.5" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush"
                                        Value="{StaticResource BorderStrongBrush}" />
                                <Setter TargetName="Label" Property="Foreground"
                                        Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <!-- Selected reads by contrast and weight rather than by
                                 colour, so it matches the segmented controls elsewhere
                                 and leaves gold to mean only "you chose this texture". -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chip" Property="Background"
                                        Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="Chip" Property="BorderBrush"
                                        Value="{StaticResource BorderStrongBrush}" />
                                <Setter TargetName="Label" Property="Foreground"
                                        Value="{StaticResource TextPrimaryBrush}" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Count" Property="Foreground"
                                        Value="{StaticResource TextSecondaryBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Mods" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource SubtleText}" Margin="0,4,0,0"
                           Text="Sections come from the tags each mod was published under. Click a mod to browse its textures, or use the switch to turn the whole mod off." />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"
                        Orientation="Horizontal">
                <Button Content="Start a mod…" Style="{StaticResource SubtleButton}"
                        Margin="0,0,12,0"
                        Command="{Binding NewModCommand}"
                        ToolTip="Create a mod folder with package.xml and source sheets that already have the right header rows" />

                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource SubtleText}"
                           Text="{Binding ResultCount, StringFormat={}{0} shown}" />
            </StackPanel>
        </Grid>

        <!-- ============ SECTIONS ============ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,12,12,5" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource SectionChip}"
                                ToolTip="{Binding Group}"
                                Command="{Binding DataContext.SelectSectionCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ============ SEARCH AND BULK ACTIONS ============ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Search" Style="{StaticResource SubtleText}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Width="240" Margin="0,0,16,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                             ToolTip="Search by mod name, package ID, author, Workshop ID or tag" />
                    <CheckBox Content="Only mods with replacement images"
                              IsChecked="{Binding TexturesOnly}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Enable all shown" Style="{StaticResource SubtleButton}"
                            Margin="0,0,6,0" Command="{Binding EnableAllShownCommand}" />
                    <Button Content="Disable all shown" Style="{StaticResource SubtleButton}"
                            Command="{Binding DisableAllShownCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ MOD LIST ============ -->
        <Grid Grid.Row="3">
            <ScrollViewer x:Name="ModScroller"
                          VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <ItemsControl ItemsSource="{Binding Items}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="12"
                                    Margin="0,0,0,9">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Enable / disable the whole mod -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                    Margin="2,0,12,0">
                                            <CheckBox IsChecked="{Binding Enabled}"
                                                      IsEnabled="{Binding CanToggle}"
                                                      HorizontalAlignment="Center"
                                                      ToolTip="Turn this whole mod on or off in loadorder.txt" />
                                            <TextBlock Text="ON" FontSize="8.5" Margin="0,3,0,0"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Visibility="{Binding Enabled,
                                                                   Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="OFF" FontSize="8.5" Margin="0,3,0,0"
                                                       HorizontalAlignment="Center" FontWeight="SemiBold"
                                                       Foreground="{StaticResource DangerBrush}"
                                                       Visibility="{Binding Enabled,
                                                                   Converter={StaticResource InverseBoolToVis}}" />
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="64" Height="64"
                                                Background="{StaticResource CheckerboardBrush}"
                                                CornerRadius="{StaticResource RadiusControl}" ClipToBounds="True">
                                            <Image Source="{Binding Preview}" Stretch="Uniform"
                                                   StretchDirection="Both" Margin="3"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        </Border>

                                        <StackPanel Grid.Column="2" Margin="14,0,12,0"
                                                    VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14.5"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />

                                                <Border Style="{StaticResource BadgeRust}" Margin="10,0,0,0"
                                                        Visibility="{Binding IsPending,
                                                                    Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="NOT SAVED" FontSize="9.5"
                                                               Foreground="{StaticResource ConflictBrush}" />
                                                </Border>

                                                <Border Style="{StaticResource BadgeDanger}" Margin="8,0,0,0"
                                                        Visibility="{Binding Enabled,
                                                                    Converter={StaticResource InverseBoolToVis}}">
                                                    <TextBlock Text="DISABLED" FontSize="9.5"
                                                               Foreground="{StaticResource DangerBrush}" />
                                                </Border>

                                                <!-- What a mod actually changes. Moss, not
                                                     gold: gold means "you chose this", and
                                                     this is a fact about the mod, not a
                                                     decision you made. -->
                                                <Border Style="{StaticResource BadgeMoss}" Margin="8,0,0,0"
                                                        Visibility="{Binding ReplacesCharacters,
                                                                    Converter={StaticResource BoolToVis}}"
                                                        ToolTip="This mod changes how NPCs, monsters or the player look">
                                                    <TextBlock Text="{Binding CharacterSummary}"
                                                               Style="{StaticResource BadgeText}"
                                                               Foreground="{StaticResource MossBrush}" />
                                                </Border>

                                                <Border Style="{StaticResource BadgeNeutral}" Margin="8,0,0,0"
                                                        Visibility="{Binding HasPortraits,
                                                                    Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding PortraitSummary}"
                                                               Style="{StaticResource BadgeText}"
                                                               FontWeight="Normal"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Border>

                                                <Border Style="{StaticResource Pill}" Margin="8,0,0,0"
                                                        Background="{StaticResource SurfaceHoverBrush}"
                                                        Visibility="{Binding MetadataMissing,
                                                                    Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="NO package.xml" FontSize="9.5"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Style="{StaticResource MonoText}" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding PackageId, Mode=OneWay}"
                                                     Foreground="{StaticResource TextSecondaryBrush}" />
                                                <Run Text="  ·  " Foreground="{StaticResource TextMutedBrush}" />
                                                <Run Text="{Binding SourceLabel, Mode=OneWay}"
                                                     Foreground="{StaticResource TextMutedBrush}" />
                                                <Run Text="{Binding WorkshopId, Mode=OneWay, TargetNullValue=-}" />
                                                <Run Text="  ·  by" Foreground="{StaticResource TextMutedBrush}" />
                                                <Run Text="{Binding Author, Mode=OneWay, TargetNullValue=unknown}" />
                                                <Run Text="  ·  updated" Foreground="{StaticResource TextMutedBrush}" />
                                                <Run Text="{Binding LastUpdatedText, Mode=OneWay}" />
                                            </TextBlock>

                                            <TextBlock Text="{Binding SectionsText}"
                                                       Style="{StaticResource MonoText}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Counts -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                                    Margin="0,0,14,0">
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding TextureCount}"
                                                           FontSize="17" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="images" Margin="5,0,0,2"
                                                           VerticalAlignment="Bottom" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding ConflictCount}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource ConflictBrush}" />
                                                <TextBlock Text="conflicts" Margin="5,0,0,0"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="·" Margin="6,0" FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding UniqueCount}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="unique" Margin="5,0,0,0"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding LoadOrderText}"
                                                       HorizontalAlignment="Right" Margin="0,3,0,0"
                                                       Style="{StaticResource MonoText}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                            <Button Content="Browse textures"
                                                    Style="{StaticResource SubtleButton}"
                                                    Margin="0,0,0,4"
                                                    Command="{Binding DataContext.OpenCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Folder" Style="{StaticResource SubtleButton}"
                                                        Margin="0,0,4,0"
                                                        Command="{Binding DataContext.OpenFolderCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Workshop" Style="{StaticResource SubtleButton}"
                                                        Visibility="{Binding WorkshopId,
                                                                    Converter={StaticResource NotNullToVis}}"
                                                        ToolTip="Open this mod's Workshop page in the Steam app. No sign-in - the link is handed to Steam on this PC and nothing is sent anywhere."
                                                        Command="{Binding DataContext.OpenWorkshopPageCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- The author's own description, from package.xml -->
                                    <Button HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Style="{StaticResource SubtleButton}"
                                            Content="Description"
                                            Visibility="{Binding HasDescription,
                                                        Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.ToggleDescriptionCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />

                                    <Border Margin="0,8,0,0" Padding="10" CornerRadius="{StaticResource RadiusControl}"
                                            Background="{StaticResource BackgroundBrush}"
                                            Visibility="{Binding DescriptionExpanded,
                                                        Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                   MaxHeight="260"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                    <Setter TargetName="Row" Property="Opacity" Value="0.55" />
                                </DataTrigger>
                                <!-- An unsaved change must stay legible, so it wins over the
                                     dimming a disabled mod gets. -->
                                <DataTrigger Binding="{Binding IsPending}" Value="True">
                                    <Setter TargetName="Row" Property="Opacity" Value="1" />
                                    <Setter TargetName="Row" Property="BorderBrush"
                                            Value="{StaticResource ConflictBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{Binding EmptyMessage}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                       TextAlignment="Center" Style="{StaticResource SubtleText}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- ============ PENDING CHANGES ============ -->
        <Border Grid.Row="4" Margin="0,10,0,12" Padding="14,11" CornerRadius="{StaticResource RadiusPanel}"
                Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource ConflictBrush}" BorderThickness="1"
                Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVis}}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PendingText}" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Style="{StaticResource SubtleText}" Margin="0,2,0,0"
                               Text="Nothing is written until you apply. loadorder.txt is backed up first, and Elin picks the change up on its next launch." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="Discard" Style="{StaticResource SubtleButton}"
                            Margin="0,0,8,0" Command="{Binding DiscardChangesCommand}" />
                    <Button Content="APPLY CHANGES" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ApplyChangesCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Margin="2,0,0,12" VerticalAlignment="Center"
                   Style="{StaticResource SubtleText}" TextWrapping="Wrap"
                   Text="{Binding StatusMessage}"
                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
