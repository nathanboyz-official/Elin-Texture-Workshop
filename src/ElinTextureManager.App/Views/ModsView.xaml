<UserControl x:Class="ElinTextureManager.App.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ElinTextureManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ModsViewModel}">

    <Grid Margin="24,18,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Mods" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource SubtleText}" Margin="0,4,0,0"
                           Text="Every detected mod. Click one to browse the textures it replaces." />
            </StackPanel>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top"
                       Style="{StaticResource SubtleText}"
                       Text="{Binding ResultCount, StringFormat={}{0} shown}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filter" Style="{StaticResource SubtleText}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Width="260" Margin="0,0,16,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                         ToolTip="Filter by mod name, author or Workshop ID" />
                <CheckBox Content="Only mods with texture replacements"
                          IsChecked="{Binding TexturesOnly}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="ModScroller" Grid.Row="2"
                      VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <ItemsControl ItemsSource="{Binding Items}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button HorizontalContentAlignment="Stretch" Margin="0,0,0,9"
                                Cursor="Hand"
                                Command="{Binding DataContext.OpenCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Row" Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="64" Height="64"
                                                    Background="{StaticResource CheckerboardBrush}"
                                                    CornerRadius="6" ClipToBounds="True">
                                                <Image Source="{Binding Preview}" Stretch="Uniform"
                                                       StretchDirection="Both" Margin="3"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="14,0,12,0"
                                                        VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="14.5"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <Border Style="{StaticResource Pill}" Margin="10,0,0,0"
                                                            Background="#4A2427"
                                                            Visibility="{Binding Enabled,
                                                                        Converter={StaticResource InverseBoolToVis}}">
                                                        <TextBlock Text="DISABLED" FontSize="9.5"
                                                                   Foreground="{StaticResource DangerBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Pill}" Margin="8,0,0,0"
                                                            Background="{StaticResource SurfaceHoverBrush}"
                                                            Visibility="{Binding MetadataMissing,
                                                                        Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="NO package.xml" FontSize="9.5"
                                                                   Foreground="{StaticResource TextMutedBrush}" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Style="{StaticResource MonoText}" Margin="0,4,0,0">
                                                    <Run Text="{Binding SourceLabel, Mode=OneWay}"
                                                         Foreground="{StaticResource TextMutedBrush}" />
                                                    <Run Text="{Binding WorkshopId, Mode=OneWay, TargetNullValue=-}" />
                                                    <Run Text="  ·  by" Foreground="{StaticResource TextMutedBrush}" />
                                                    <Run Text="{Binding Author, Mode=OneWay, TargetNullValue=unknown}" />
                                                    <Run Text="  ·  updated" Foreground="{StaticResource TextMutedBrush}" />
                                                    <Run Text="{Binding LastUpdatedText, Mode=OneWay}" />
                                                </TextBlock>

                                                <TextBlock Text="{Binding Directory}"
                                                           Style="{StaticResource MonoText}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Directory}" />
                                            </StackPanel>

                                            <!-- Counts -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                        Margin="0,0,14,0">
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding TextureCount}"
                                                               FontSize="17" FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="textures" Margin="5,0,0,2"
                                                               VerticalAlignment="Bottom" FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding ConflictCount}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource ConflictBrush}" />
                                                    <TextBlock Text="conflicts" Margin="5,0,0,0"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="·" Margin="6,0" FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding UniqueCount}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="unique" Margin="5,0,0,0"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding LoadOrderText}"
                                                           HorizontalAlignment="Right" Margin="0,3,0,0"
                                                           Style="{StaticResource MonoText}" />
                                            </StackPanel>

                                            <Button Grid.Column="3" Content="Folder"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SubtleButton}"
                                                    Command="{Binding DataContext.OpenFolderCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background"
                                                    Value="{StaticResource SurfaceRaisedBrush}" />
                                            <Setter TargetName="Row" Property="BorderBrush"
                                                    Value="{StaticResource BorderStrongBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                            <Setter TargetName="Row" Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
