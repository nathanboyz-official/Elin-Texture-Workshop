<UserControl x:Class="ElinTextureManager.App.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ElinTextureManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:GuideViewModel}">

    <UserControl.Resources>
        <!-- One line of a topic. The kind decides how it reads: a trap is the reason this
             page exists, so it is the one thing that is coloured. -->
        <DataTemplate x:Key="GuideLine" DataType="{x:Type vm:GuideLineViewModel}">
            <Grid Margin="0,0,0,4">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="820"
                           HorizontalAlignment="Left"
                           Style="{StaticResource BodyText}"
                           Visibility="{Binding IsBody, Converter={StaticResource BoolToVis}}" />

                <TextBlock TextWrapping="Wrap" MaxWidth="800" HorizontalAlignment="Left"
                           Margin="14,0,0,0" Style="{StaticResource BodyText}"
                           Visibility="{Binding IsBullet, Converter={StaticResource BoolToVis}}">
                    <Run Text="·" Foreground="{StaticResource TextMutedBrush}" />
                    <Run Text="{Binding Text, Mode=OneWay}" />
                </TextBlock>

                <Border Background="{StaticResource SurfaceSunkenBrush}"
                        CornerRadius="3" Padding="10,5" HorizontalAlignment="Left"
                        Visibility="{Binding IsCode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="12.5"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </Border>

                <Border BorderBrush="{StaticResource DangerBrush}" BorderThickness="2,0,0,0"
                        Padding="12,4,0,4" Margin="0,4" MaxWidth="820"
                        HorizontalAlignment="Left"
                        Visibility="{Binding IsTrap, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="EASY TO GET WRONG" Style="{StaticResource SectionHeader}"
                                   Foreground="{StaticResource DangerBrush}" Margin="0,0,0,3" />
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                   Style="{StaticResource BodyText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GuideTopic" DataType="{x:Type vm:GuideTopicViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,15">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,5" />

                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" MaxWidth="820"
                               HorizontalAlignment="Left" Margin="0,0,0,12"
                               Style="{StaticResource SubtleText}"
                               Foreground="{StaticResource TextMutedBrush}" />

                    <ItemsControl ItemsSource="{Binding Lines}"
                                  ItemTemplate="{StaticResource GuideLine}" />

                    <ItemsControl ItemsSource="{Binding Links}" Margin="0,10,0,0"
                                  Visibility="{Binding HasLinks,
                                               Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}"
                                        Style="{StaticResource SubtleButton}"
                                        Margin="0,0,8,8"
                                        ToolTip="{Binding Url}"
                                        Command="{Binding DataContext.OpenLinkCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="26,22,26,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Modding Guide" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubtleText}"
                       Margin="0,3,0,0" MaxWidth="820" HorizontalAlignment="Left"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sections}" Margin="0,0,14,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding Title}"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="0,6,0,8" />
                            <ItemsControl ItemsSource="{Binding Topics}"
                                          ItemTemplate="{StaticResource GuideTopic}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
