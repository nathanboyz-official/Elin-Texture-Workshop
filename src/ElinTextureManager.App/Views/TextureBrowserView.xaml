<UserControl x:Class="ElinTextureManager.App.Views.TextureBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:ElinTextureManager.App.Controls"
             xmlns:vm="clr-namespace:ElinTextureManager.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:TextureBrowserViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>

        <!-- ============ TEXTURE CARD ============ -->
        <Style x:Key="TextureCardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="8"
                                SnapsToDevicePixels="True">
                            <DockPanel>

                                <!-- Badges -->
                                <Grid DockPanel.Dock="Top" Margin="1,1,1,6" Height="17">
                                    <Border Style="{StaticResource Pill}" HorizontalAlignment="Left"
                                            Background="#4A3416"
                                            Visibility="{Binding HasConflict,
                                                        Converter={StaticResource BoolToVis}}">
                                        <TextBlock FontSize="9.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource ConflictBrush}"
                                                   Text="{Binding Entry.SourceCount,
                                                          StringFormat={}{0} SOURCES}" />
                                    </Border>

                                    <Border Style="{StaticResource Pill}" HorizontalAlignment="Right"
                                            Background="#1D4436"
                                            Visibility="{Binding HasOverride,
                                                        Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#x2713; OVERRIDE" FontSize="9.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource SelectedBrush}" />
                                    </Border>
                                </Grid>

                                <!-- Caption -->
                                <StackPanel DockPanel.Dock="Bottom" Margin="3,7,3,2">
                                    <TextBlock Text="{Binding TextureId}" FontSize="12.5"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimaryBrush}" />

                                    <TextBlock Text="{Binding DisplayName}" FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource AccentBrush}"
                                               Visibility="{Binding HasDisplayName,
                                                           Converter={StaticResource BoolToVis}}" />

                                    <TextBlock Text="{Binding SourceSummary}" FontSize="10.5"
                                               Margin="0,2,0,0"
                                               Foreground="{StaticResource TextMutedBrush}" />

                                    <TextBlock FontSize="10.5" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="{Binding CurrentLabel}"
                                               ToolTip="{Binding CurrentLabel}" />
                                </StackPanel>

                                <!-- Preview: checkerboard behind, nearest-neighbour, aspect preserved -->
                                <Border Background="{StaticResource CheckerboardBrush}"
                                        CornerRadius="6" ClipToBounds="True">
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="Uniform"
                                           StretchDirection="Both"
                                           Margin="4"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           RenderOptions.EdgeMode="Aliased" />
                                </Border>
                            </DockPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background"
                                        Value="{StaticResource SurfaceRaisedBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{StaticResource BorderStrongBrush}" />
                            </Trigger>

                            <!-- A texture you have overridden -->
                            <DataTrigger Binding="{Binding HasOverride}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{StaticResource SelectedBrush}" />
                            </DataTrigger>

                            <!-- Conflict, but every version is byte-identical: not a real choice -->
                            <DataTrigger Binding="{Binding IsIdenticalConflict}" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.82" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubtleText}"
                           Margin="0,4,0,0"
                           Visibility="{Binding Subtitle, Converter={StaticResource NotNullToVis}}" />
            </StackPanel>

            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top"
                       Style="{StaticResource SubtleText}"
                       Text="{Binding ResultCount, StringFormat={}{0} shown}" />
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,14">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Show" Style="{StaticResource SubtleText}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />

                <RadioButton Content="All" GroupName="Scope" Margin="0,0,10,0"
                             IsChecked="{Binding Scope, Converter={StaticResource EnumMatch},
                                         ConverterParameter=All}" />
                <RadioButton Content="Conflicts only" GroupName="Scope" Margin="0,0,10,0"
                             IsChecked="{Binding Scope, Converter={StaticResource EnumMatch},
                                         ConverterParameter=ConflictsOnly}" />
                <RadioButton Content="Selected only" GroupName="Scope" Margin="0,0,10,0"
                             IsChecked="{Binding Scope, Converter={StaticResource EnumMatch},
                                         ConverterParameter=SelectedOnly}" />
                <RadioButton Content="Unselected only" GroupName="Scope" Margin="0,0,18,0"
                             IsChecked="{Binding Scope, Converter={StaticResource EnumMatch},
                                         ConverterParameter=UnselectedOnly}" />

                <TextBlock Text="Prefix" Style="{StaticResource SubtleText}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="PrefixCombo" MinWidth="150" Margin="0,0,14,0"
                          ItemsSource="{Binding AvailablePrefixes}"
                          SelectedIndex="0"
                          SelectionChanged="PrefixCombo_SelectionChanged" />

                <Button Content="Clear filters" Style="{StaticResource SubtleButton}"
                        Command="{Binding ClearFiltersCommand}" />
            </WrapPanel>
        </Border>

        <!-- Grid -->
        <Grid Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Items}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer Focusable="False" Padding="0,0,4,0">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ctrl:VirtualizingWrapPanel
                            ItemWidth="{Binding CardWidth}"
                            ItemHeight="{Binding CardHeight}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TextureCardButton}"
                                Loaded="Card_Loaded"
                                Command="{Binding DataContext.OpenCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty state -->
            <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource SubtleText}"
                           MaxWidth="420" TextAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
