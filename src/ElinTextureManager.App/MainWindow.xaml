<Window x:Class="ElinTextureManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ElinTextureManager.App.ViewModels"
        xmlns:views="clr-namespace:ElinTextureManager.App.Views"
        Title="Elin Texture Manager"
        Height="900" Width="1440"
        MinHeight="620" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Each page view model maps to its view. -->
        <DataTemplate DataType="{x:Type vm:TextureBrowserViewModel}">
            <views:TextureBrowserView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TextureDetailViewModel}">
            <views:TextureDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OverridesViewModel}">
            <views:OverridesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModsViewModel}">
            <views:ModsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoadOrderViewModel}">
            <views:LoadOrderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <!-- Sidebar entry -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Nav" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="8,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="7" Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="Bar" Grid.Column="0" Width="3" CornerRadius="2"
                                        Background="Transparent" Margin="-6,2,9,2" />

                                <TextBlock Grid.Column="1" Text="{Binding Label}"
                                           VerticalAlignment="Center" />

                                <Border Grid.Column="2" Style="{StaticResource Pill}"
                                        Background="{StaticResource SurfaceHoverBrush}"
                                        Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Badge}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{StaticResource SurfaceBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{StaticResource SurfaceRaisedBrush}" />
                                <Setter TargetName="Bar" Property="Background"
                                        Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Escape" Command="{Binding BackCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== SIDEBAR ==================== -->
        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,18">
                    <TextBlock Text="ELIN" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="TEXTURE MANAGER" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,1,0,0" />
                </StackPanel>

                <!-- Override count, the headline number of the whole app -->
                <Border DockPanel.Dock="Bottom" Margin="16,10,16,16" Padding="12,10"
                        Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="YOUR OVERRIDES" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding OverrideCount}" FontSize="21" FontWeight="Bold"
                                       Foreground="{StaticResource SelectedBrush}" />
                            <TextBlock Text="textures" FontSize="11" VerticalAlignment="Bottom"
                                       Margin="6,0,0,4"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding NavItems}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource NavButton}"
                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Command="{Binding DataContext.NavigateCommand,
                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding Key}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- ==================== MAIN AREA ==================== -->
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="&#x2190;  Back" Style="{StaticResource SubtleButton}"
                            Command="{Binding BackCommand}" Margin="0,0,14,0"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}" />

                    <Grid Grid.Column="1" MaxWidth="480" HorizontalAlignment="Left">
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding Browser.SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                        <TextBlock Text="Search textures, mods or Workshop IDs   (Ctrl+F)"
                                   IsHitTestVisible="False" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12.5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Browser.SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="Elin is running" VerticalAlignment="Center" FontSize="12"
                                   Margin="0,0,14,0" Foreground="{StaticResource ConflictBrush}"
                                   Visibility="{Binding ElinRunning, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Refresh Mods   (F5)" Style="{StaticResource PrimaryButton}"
                                Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Notices -->
            <StackPanel Grid.Row="1">
                <Border Background="#1F2B3A" BorderBrush="{StaticResource AccentDarkBrush}"
                        BorderThickness="0,0,0,1" Padding="24,10"
                        Visibility="{Binding HasChangeNotice, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Dismiss"
                                Style="{StaticResource SubtleButton}"
                                Command="{Binding DismissNoticeCommand}" />
                        <TextBlock Text="{Binding ChangeNotice}" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" />
                    </DockPanel>
                </Border>

                <Border Background="#3A2E1A" BorderBrush="{StaticResource ConflictBrush}"
                        BorderThickness="0,0,0,1" Padding="24,10"
                        Visibility="{Binding RestartNeeded, Converter={StaticResource BoolToVis}}">
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5"
                               Text="Changes saved. Restart Elin to apply your texture changes." />
                </Border>

                <ProgressBar Value="{Binding ScanProgress, Mode=OneWay}" Maximum="100"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <!-- Page content -->
            <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" />
        </Grid>

        <!-- ==================== STATUS BAR ==================== -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="18,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MonoText}" Margin="0,0,16,0">
                        <Run Text="{Binding ModCount, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Run Text="texture mods" />
                        <Run Text="/" />
                        <Run Text="{Binding TotalModCount, Mode=OneWay}" />
                        <Run Text="total" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource MonoText}" Margin="0,0,16,0">
                        <Run Text="{Binding TextureCount, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Run Text="textures" />
                        <Run Text="/" />
                        <Run Text="{Binding UniqueCount, Mode=OneWay}" />
                        <Run Text="IDs" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource MonoText}" Margin="0,0,16,0">
                        <Run Text="{Binding ConflictCount, Mode=OneWay}" Foreground="{StaticResource ConflictBrush}" />
                        <Run Text="conflicts" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource MonoText}">
                        <Run Text="{Binding OverrideCount, Mode=OneWay}" Foreground="{StaticResource SelectedBrush}" />
                        <Run Text="overrides" />
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="1" Style="{StaticResource MonoText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="{Binding ActivityText}"
                           Visibility="{Binding ActivityText, Converter={StaticResource NotNullToVis}}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MonoText}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Log" Style="{StaticResource SubtleButton}" Padding="8,2"
                            Command="{Binding OpenLogCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
